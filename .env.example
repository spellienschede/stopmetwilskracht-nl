# Grippartner – omgevingsvariabelen (voorbeeld)
# Kopieer naar .env OF gebruik config.local.php (aanbevolen op shared hosting).
# Zet NOOIT echte secrets in Git.

APP_BASE_URL=https://www.grippartner.nl
APP_ENV=production
APP_DEBUG=0

# Database (bestaande grippartner-DB)
DB_HOST=localhost
DB_NAME=grippartner
DB_USER=grip
DB_PASS=

# Boek
BOOK_TITLE=Grippartner
BOOK_SUBTITLE=De verrassend eenvoudige manier om vol te houden wat je écht belangrijk vindt
BOOK_HOOK=Waarom jij niet zoekt naar een grippartner, maar er wel één nodig hebt
BOOK_AUTHOR=Korne Pot
BOOK_PRICE_CENTS=4900
BOOK_CURRENCY=EUR
BOOK_PRESALE_PRICE_CENTS=3900
BOOK_PRESALE_END_DATE=2026-09-21
BOOK_RELEASE_DATE=2026-10-05
BOOK_PRESENTATION_DATE=2026-10-19
BOOK_PRESENTATION_TIME=19:30
DEFAULT_COUNTRY=NL
TIMEZONE=Europe/Amsterdam

# Mollie (test key begint met test_, live met live_)
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=https://www.grippartner.nl/webhook-mollie.php

# Mail
MAIL_FROM_ADDRESS=info@kornepot.nl
MAIL_FROM_NAME=Korne Pot / Grippartner
ADMIN_NOTIFICATION_EMAIL=info@kornepot.nl

# SMTP (optioneel; zonder SMTP valt terug op PHP mail())
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=ssl

# Optioneel: bedrijfsgegevens voor voorwaarden/privacy (TODO door Korne)
# LEGAL_BUSINESS_NAME=
# LEGAL_ADDRESS=
# LEGAL_KVK=
# LEGAL_BTW=
# LEGAL_ISBN=
